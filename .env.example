# Server
PORT=3000
BASE_URL=https://core.zycloud.space
# Origin of the separate frontend SPA — used for the post-login redirect and CORS
# (must exactly match the SPA's origin, or the browser rejects credentialed requests).
# Local dev against the `app/` SPA (`yarn dev`, default vite port): http://localhost:5173
APP_URL=https://app.zycloud.space
LOG_LEVEL=info

# Sessions
# Lifetime of the zycloud session cookie / Session row, in days (default 30).
SESSION_TTL_DAYS=30

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=github-integration

# CapRover
CAPROVER_URL=https://captain.zycloud.space
CAPROVER_PASSWORD=

# Env var secret encryption (AppConfig -> EnvVar.value)
# Base64-encoded 32-byte key for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit the real value. Provisioned like the other secrets above
# (CapRover App Config in prod, .env locally).
ENV_VAR_ENCRYPTION_KEY=

# Database — PostgreSQL for both local dev and production (same engine, one schema).
# The test suite uses SQLite automatically (see vitest.config.js) — nothing to set here.
#   Local dev:  DATABASE_URL="postgresql://user@localhost:5432/zycloud_dev"
#   Production: DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://user@localhost:5432/zycloud_dev"
