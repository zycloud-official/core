// Development schema — SQLite
// Used locally via: yarn dev:db:push
// For production (PostgreSQL), use prisma/schema.prisma
// NOTE: keep this file in lockstep with schema.prisma (only the datasource differs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Provider-agnostic zycloud account. Identity is NOT bound to any login provider
// (GitHub, yangfrenz, …) — those attach as AuthIdentity rows. `email` is the
// stable linking key when a provider asserts a verified address.
model Account {
  id              Int                @id @default(autoincrement())
  email           String?            @unique
  displayName     String?            @map("display_name")
  avatarUrl       String?            @map("avatar_url")
  role            String             @default("USER")
  tier            String             @default("FREE")
  status          String             @default("ACTIVE")
  createdAt       DateTime           @default(now()) @map("created_at")
  identities      AuthIdentity[]
  sessions        Session[]
  sourceConnections SourceConnection[]
  apps            App[]

  @@map("accounts")
}

// A linked login method for an account. `providerSubject` is the provider's
// stable subject (GitHub user id, yangfrenz `sub`); `providerUsername` is the
// human handle, kept queryable for things like linking source connections.
model AuthIdentity {
  id               Int      @id @default(autoincrement())
  accountId        Int      @map("account_id")
  provider         String
  providerSubject  String   @map("provider_subject")
  providerUsername String?  @map("provider_username")
  createdAt        DateTime @default(now()) @map("created_at")
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("auth_identities")
}

// Opaque server-side session (replaces the old sessionToken column on Member).
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  accountId Int      @map("account_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// A deployment source linked to an account — provider-agnostic so GitLab/others
// can be added later. For GitHub: `externalId` is the App installation id and
// `ownerLogin` the GitHub owner login. `accountId` is null until the owner signs
// in (back-linked at login by ownerLogin).
model SourceConnection {
  id         Int      @id @default(autoincrement())
  provider   String
  externalId String   @map("external_id")
  ownerLogin String   @map("owner_login")
  accountId  Int?     @map("account_id")
  createdAt  DateTime @default(now()) @map("created_at")
  account    Account? @relation(fields: [accountId], references: [id])
  apps       App[]

  @@unique([provider, externalId])
  @@map("source_connections")
}

model App {
  id                 Int               @id @default(autoincrement())
  accountId          Int?              @map("account_id")
  sourceConnectionId Int?              @map("source_connection_id")
  githubRepo         String            @unique @map("github_repo")
  caproverAppName    String            @map("caprover_app_name")
  previewUrl         String?           @map("preview_url")
  createdAt          DateTime          @default(now()) @map("created_at")
  account            Account?          @relation(fields: [accountId], references: [id])
  sourceConnection   SourceConnection? @relation(fields: [sourceConnectionId], references: [id])
  config             AppConfig?
  deploys            Deploy[]

  @@map("apps")
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  appId     Int      @unique @map("app_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("app_configs")
}

model Deploy {
  id        Int      @id @default(autoincrement())
  appId     Int      @map("app_id")
  commitSha String?  @map("commit_sha")
  status    String   @default("queued")
  log       String?
  createdAt DateTime @default(now()) @map("created_at")
  app       App      @relation(fields: [appId], references: [id])

  @@map("deploys")
}
